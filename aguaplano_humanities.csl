<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="sort-only" default-locale="it-IT">
  <info>
    <title>Aguaplano Humanities (Full Notes, Italian)</title>
    <title-short>Aguaplano Humanities</title-short>
    <id>http://www.zotero.org/styles/aguaplano-humanities</id>
    <link href="http://www.zotero.org/styles/aguaplano-humanities" rel="self"/>
    <link href="http://www.aguaplano.eu" rel="documentation"/>
    <author>
      <name>Gemini</name>
    </author>
    <category citation-format="note"/>
    <category field="humanities"/>
    <updated>2026-11-03T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="it">
    <terms>
      <term name="editor" form="short">a cura di</term>
      <term name="page-range-delimiter">-</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
    </terms>
  </locale>

  <!-- AUTORE IN NOTA: Iniziale Nome. COGNOME in MAIUSCOLETTO (es. J. HABERMAS) -->
  <macro name="author-note">
    <names variable="author">
      <name initialize-with=". " delimiter="-" font-variant="small-caps"/>
      <substitute>
        <names variable="editor">
          <name initialize-with=". " delimiter="-" font-variant="small-caps"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator"/>
        <text variable="title" font-style="italic"/>
      </substitute>
    </names>
  </macro>

  <!-- AUTORE IN BIBLIOGRAFIA: COGNOME per esteso, Nome (es. FREUD, Sigmund) -->
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="first" sort-separator=", " delimiter="-" font-variant="small-caps"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="first" sort-separator=", " delimiter="-"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator"/>
        <text variable="title" font-style="italic"/>
      </substitute>
    </names>
  </macro>

  <macro name="title-note">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher-note">
    <group delimiter=", ">
      <text variable="publisher"/>
      <group delimiter=" ">
        <text variable="publisher-place"/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>

  <macro name="locators-note">
    <choose>
      <if variable="locator">
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- CITAZIONE IN NOTA A PIÈ DI PAGINA -->
  <citation>
    <layout suffix="." delimiter="; ">
      <choose>
        <!-- Riferimento identico e stessa pagina: Ibidem -->
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text value="Ivi" font-style="italic"/>
            <text macro="locators-note"/>
          </group>
        </if>
        <else-if position="ibid">
          <text value="Ibidem" font-style="italic"/>
        </else-if>
        <!-- Prima citazione completa della fonte in nota -->
        <else>
          <group delimiter=", ">
            <text macro="author-note"/>
            <text macro="title-note"/>
            <choose>
              <!-- Articolo in rivista: Iniziale. Cognome, Titolo, in «Rivista», Anno (Vol), pp. X-Y -->
              <if type="article-journal article-magazine article-newspaper" match="any">
                <group delimiter=" ">
                  <text term="in"/>
                  <text variable="container-title" prefix="&#171;" suffix="&#187;"/>
                </group>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
                <text variable="volume" prefix="(" suffix=")"/>
                <group delimiter=" ">
                  <label variable="page" form="short"/>
                  <text variable="page"/>
                </group>
              </if>
              <!-- Saggio in libro collettivo -->
              <else-if type="chapter paper-conference" match="any">
                <group delimiter=" ">
                  <text term="in"/>
                  <text variable="container-title" font-style="italic"/>
                </group>
                <names variable="editor">
                  <label form="short" suffix=" "/>
                  <name initialize-with=". " delimiter="-"/>
                </names>
                <text macro="publisher-note"/>
              </else-if>
              <!-- Monografia -->
              <else>
                <text macro="publisher-note"/>
              </else>
            </choose>
            <text macro="locators-note"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>

  <!-- BIBLIOGRAFIA FINALE -->
  <bibliography hanging-indent="true" entry-spacing="1">
    <sort>
      <key macro="author-bib"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=", ">
        <text macro="author-bib"/>
        <text macro="title-note"/>
        <choose>
          <if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=" ">
              <text term="in"/>
              <text variable="container-title" prefix="&#171;" suffix="&#187;"/>
            </group>
            <date variable="issued">
              <date-part name="year"/>
            </date>
            <text variable="volume" prefix="(" suffix=")"/>
            <group delimiter=" ">
              <label variable="page" form="short"/>
              <text variable="page"/>
            </group>
          </if>
          <else-if type="chapter paper-conference" match="any">
            <group delimiter=" ">
              <text term="in"/>
              <text variable="container-title" font-style="italic"/>
            </group>
            <text macro="publisher-note"/>
            <group delimiter=" ">
              <label variable="page" form="short"/>
              <text variable="page"/>
            </group>
          </else-if>
          <else>
            <text macro="publisher-note"/>
          </else>
        </choose>
      </group>
      <choose>
        <if variable="original-title">
          <group prefix=" [" suffix="]" delimiter=", ">
            <text variable="original-title" font-style="italic"/>
            <text variable="original-publisher"/>
            <text variable="original-publisher-place"/>
            <date variable="original-date">
              <date-part name="year"/>
            </date>
          </group>
        </if>
      </choose>
    </layout>
  </bibliography>
</style>